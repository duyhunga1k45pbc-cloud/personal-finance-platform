{
  "realm": "pfp-e2e",
  "enabled": true,
  "clients": [
    {
      "clientId": "moneta",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "protocol": "openid-connect",
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "profile",
        "roles",
        "email"
      ],
      "protocolMappers": [
        {
          "name": "pfp-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "pfp-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "e2e-user",
      "enabled": true,
      "emailVerified": true,
      "email": "e2e@example.test",
      "credentials": [
        {
          "type": "password",
          "value": "e2e-test-password",
          "temporary": false
        }
      ],
      "firstName": "E2E",
      "lastName": "Test",
      "requiredActions": []
    }
  ]
}
